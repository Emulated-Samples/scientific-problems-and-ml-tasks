+        base % facebook::cachelib::Slab::kSize != 0 ||
+        size < facebook::cachelib::Slab::kSize ||
+        size % facebook::cachelib::Slab::kSize != 0 ||
+        base > std::numeric_limits<size_t>::max() - size) {
