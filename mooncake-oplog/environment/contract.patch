-void EtcdOpLogChangeNotifier::Stop() {
-    if (!running_.load()) {
-        return;
-    }
-
-    running_.store(false);
-
-    // Invalidate the callback context under the mutex.
-    if (callback_ctx_) {
-        std::lock_guard<std::mutex> lock(callback_ctx_->mutex);
-        callback_ctx_->notifier = nullptr;
