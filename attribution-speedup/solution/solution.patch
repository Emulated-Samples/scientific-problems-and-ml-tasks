 """
 
+from typing import TYPE_CHECKING
+
 import torch
 
+if TYPE_CHECKING:
+    # _phases imports from this module at runtime; break the cycle by
+    # taking _Layout as a type annotation only.
+    from lat.attribution._phases import _Layout
