@@ -0,0 +1,79 @@
+"""Regression: the MLP substitution must stay faithful for transcoders that
+carry an affine skip path (``W_skip``/``compute_skip``).
+
+The faithfulness contract says ``error_vec`` absorbs whatever the feature
+reconstruction doesn't carry, so ``apply_mlp`` reproduces the true MLP
+output on the snapshot regardless of transcoder internals. A linearization
+that folds the skip term into the reconstruction the error is computed
+against — without the IR carrying it forward — silently drops the skip
+contribution from every MLP output. Uses a mock transcoder so the test is
+hermetic (no model download).
+"""
+
+import torch
+
+from lat.ir import LinearizedMLP, NormSnapshot
+from lat.linearize import _extract_active_features
+from lat.primitives import apply_mlp
+
+_N_POS, _D_MODEL, _D_TC = 5, 16, 32
+
+
+class _SkipTranscoder:
+    d_model = _D_MODEL
+
+    def __init__(self):
+        g = torch.Generator().manual_seed(7)
+        self.W_enc = torch.randn(_D_TC, _D_MODEL, generator=g) * 0.3
+        self.W_dec = torch.randn(_D_TC, _D_MODEL, generator=g) * 0.3
+        self.b_enc = torch.randn(_D_TC, generator=g) * 0.05
+        self.b_dec = torch.randn(_D_MODEL, generator=g) * 0.05
+        self.W_skip = torch.randn(_D_MODEL, _D_MODEL, generator=g) * 0.1
+
+    def encode_sparse(self, mlp_in, *, zero_positions):
+        acts = torch.relu(mlp_in @ self.W_enc.T + self.b_enc)
+        pos_idx, feat_idx = acts.nonzero(as_tuple=True)
+        sparse = torch.sparse_coo_tensor(
+            torch.stack([pos_idx, feat_idx]), acts[pos_idx, feat_idx], acts.shape
+        ).coalesce()
+        pos_idx, feat_idx = sparse.indices()
+        return sparse, self.W_enc[feat_idx]
+
+    def _get_decoder_vectors(self, feat_idx):
+        return self.W_dec[feat_idx]
+
+    def compute_skip(self, input_acts):
+        return input_acts @ self.W_skip.T
+
+    def true_output(self, mlp_in):
+        acts = torch.relu(mlp_in @ self.W_enc.T + self.b_enc)
+        return acts @ self.W_dec + self.b_dec + self.compute_skip(mlp_in)
+
+
+def test_apply_mlp_faithful_with_skip_transcoder():
+    tc = _SkipTranscoder()
+    mlp_in = torch.randn(_N_POS, _D_MODEL, generator=torch.Generator().manual_seed(3)) * 0.5
+    mlp_out = tc.true_output(mlp_in)
+
+    active, reconstruction = _extract_active_features(tc, mlp_in, slice(0, 0), 0.0)
+    error_vec = (mlp_out - reconstruction).detach().clone()
+    mlp = LinearizedMLP(
+        active_positions=active["positions"],
+        active_feature_idx=active["feature_idx"],
+        active_activations=active["activations"],
+        W_enc_active=active["W_enc_rows"],
+        W_dec_active=active["W_dec_rows"],
+        b_enc_active=active["b_enc_rows"],
+        b_dec=tc.b_dec.detach(),
+        d_transcoder=_D_TC,
+        pre_norm=NormSnapshot(
+            scale=torch.ones(_N_POS), gamma=torch.ones(_D_MODEL), mean=None, beta=None
+        ),
+        error_vec=error_vec,
+    )
+    got = apply_mlp(mlp, mlp_in)
+    deviation = (got - mlp_out).abs().max().item()
+    assert deviation < 1e-5, (
+        f"apply_mlp deviates from the true MLP output by {deviation:.4f} on a "
+        f"skip transcoder — the skip contribution is being dropped"
+    )
