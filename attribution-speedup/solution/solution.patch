@@ -0,0 +1,22 @@
+"""Optimized attribution engine — a drop-in port of ``lat``'s engine.
+
+``lat_fast`` reimplements the attribution hot path (the backward sweep and
+its batching) against the same IR, exploiting the structure a causal model
+guarantees: gradient seeded at layer ``l``, position ``p`` can only reach
+layers ``<= l`` and positions ``<= p``, so the sweep works on exactly that
+cone instead of the full ``n_layers x n_pos`` grid. Feature records are
+contracted per position group instead of per feature.
+
+Public API matches ``lat``: ``attribute_linear`` / ``attribute_from_linearized``
+with identical signatures and identical outputs on every input. Everything
+that is not performance-relevant (IR, linearization, target resolution,
+graph assembly, artifacts) is shared with ``lat`` directly — this package
+is the engine only.
+"""
+
+from lat_fast.attribute import attribute_from_linearized, attribute_linear
+
+__all__ = [
+    "attribute_from_linearized",
+    "attribute_linear",
+]
diff --git a/workspace/src/lat_fast/_phases.py b/workspace/src/lat_fast/_phases.py
