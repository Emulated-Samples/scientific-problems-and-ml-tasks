+"""Contract tests for the small query/pruning surfaces.
+
+Three properties that the broader suites exercise only obliquely:
+
+- the per-row edge cap keeps exactly K entries (not K-1, not K+ties);
+- ``Circuit.neighbors`` is undirected (incoming sources count as neighbors);
+- ``Circuit.find`` matches node ids case-insensitively, as documented.
+"""
+
+import json
+from pathlib import Path
+
+import pytest
+import torch
+
+from lat.attribution._phases import _prune_rows
+from lat.circuit import Circuit
+
+FIXTURE = Path(__file__).parent / "fixtures" / "circuits" / "capital_of_france.json"
+
+
+@pytest.fixture(scope="module")
+def circuit() -> Circuit:
+    return Circuit.from_neuronpedia_json(json.loads(FIXTURE.read_text()))
+
+
+def test_prune_cap_keeps_exactly_k() -> None:
+    # Distinct magnitudes, no ties: the cap must keep exactly K survivors.
+    rows = torch.tensor([[0.5, -3.0, 1.25, -0.75, 2.0, 0.125, -1.5, 0.25]])
+    _prune_rows(rows, floor=0.0, max_edges=3)
+    assert int((rows != 0).sum()) == 3
+    # ... and they are the K strongest by magnitude.
+    assert set(rows[0].nonzero().flatten().tolist()) == {1, 4, 6}
+
+
+def test_neighbors_includes_incoming_sources(circuit: Circuit) -> None:
+    node = "L_0_12095_5"
+    incoming = {e.source for e in circuit.edges_into(node)}
+    outgoing = {e.target for e in circuit.edges_from(node)}
+    assert incoming, "fixture must give the probed node at least one incomer"
+    neighborhood = set(circuit.neighbors(node))
+    assert incoming <= neighborhood
+    assert outgoing <= neighborhood
+    # Symmetry: if a is b's neighbor, b is a's neighbor.
+    a = next(iter(incoming))
+    assert node in circuit.neighbors(a)
+
+
+def test_find_is_case_insensitive_on_ids(circuit: Circuit) -> None:
+    # Node ids carry uppercase kind prefixes ("L_...", "T_..."); a
+    # lowercase query must still match them.
+    assert "L_0_12095_5" in {n.node_id for n in circuit.find("l_0_12095")}
+    assert "L_0_12095_5" in {n.node_id for n in circuit.find("L_0_12095")}
