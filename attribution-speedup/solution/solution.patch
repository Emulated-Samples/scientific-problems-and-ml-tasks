+++ b/workspace/tests/test_fast_engine.py
@@ -0,0 +1,271 @@
+"""Tests for the optimized engine (``lat_fast``).
+
+Covers the engine machinery (cone bounds, sweep plan, kernel dispatch) and
+sweep-level parity with the reference on logit attribution batches. Uses
+small synthetic IRs throughout — fast, deterministic, no model downloads.
+"""
+
+import pytest
+import torch
+
+import lat.primitives as ref
+import lat_fast
+import lat_fast.primitives as fast
+from lat.ir import (
+    LinearizedAttention,
+    LinearizedAttribution,
+    LinearizedLayer,
+    LinearizedMLP,
+    NormSnapshot,
+)
+
+
+class _Tok:
+    def decode(self, ids):
+        if isinstance(ids, int):
+            return f"<t{ids}>"
+        return " ".join(f"<t{int(i)}>" for i in torch.as_tensor(ids).flatten())
+
+
+def _norm(n_pos, d, g):
+    return NormSnapshot(
+        scale=torch.rand(n_pos, generator=g) + 0.5,
+        gamma=torch.randn(d, generator=g) * 0.2 + 1.0,
+        mean=None,
+        beta=None,
+    )
+
+
+def _ir(n_layers=3, n_pos=10, d=16, feats_per_pos=2, seed=0, heads=2, dh=4,
+        causal=True, errors=False):
+    """Small synthetic IR with active features at every position."""
+    g = torch.Generator().manual_seed(seed)
+    pattern = torch.tril(torch.ones(n_pos, n_pos)) if causal else torch.ones(n_pos, n_pos)
+    pattern = pattern / pattern.sum(-1, keepdim=True)
+    n_active = feats_per_pos * n_pos
+    positions = torch.arange(n_pos, dtype=torch.long).repeat_interleave(feats_per_pos)
+    layers = []
+    for i in range(n_layers):
+        attention = LinearizedAttention(
+            pattern=pattern.unsqueeze(0).repeat(heads, 1, 1) * 0.3,
+            W_V=torch.randn(heads, d, dh, generator=g) * 0.2,
+            W_O=torch.randn(heads, dh, d, generator=g) * 0.2,
+            b_V=None,
+            b_O=None,
+            pre_norm=_norm(n_pos, d, g),
+            is_causal=causal,
+        )
+        mlp = LinearizedMLP(
+            active_positions=positions,
+            active_feature_idx=torch.arange(n_active, dtype=torch.long),
+            active_activations=torch.rand(n_active, generator=g) + 0.2,
+            W_enc_active=torch.randn(n_active, d, generator=g) * 0.3,
+            W_dec_active=torch.randn(n_active, d, generator=g) * 0.3,
+            b_enc_active=torch.zeros(n_active),
+            b_dec=torch.zeros(d),
+            d_transcoder=n_active,
+            pre_norm=_norm(n_pos, d, g),
+            error_vec=(torch.randn(n_pos, d, generator=g) * 0.1 if errors
+                       else torch.zeros(n_pos, d)),
+        )
+        layers.append(LinearizedLayer(layer_idx=i, attention=attention, mlp=mlp))
+    return LinearizedAttribution(
+        input_tokens=torch.arange(n_pos, dtype=torch.long) % 5,
+        resid_0=torch.randn(n_pos, d, generator=g) * 0.3,
+        embed_vecs=torch.randn(n_pos, d, generator=g) * 0.3,
+        layers=tuple(layers),
+        final_norm=_norm(n_pos, d, g),
+        W_unembed=torch.randn(d, 24, generator=g),
+        b_unembed=None,
+        logits=torch.randn(n_pos, 24, generator=g),
+    )
+
+
+# ─── Public API surface ─────────────────────────────────────────────────────
+
+
+def test_api_signatures_match_reference():
+    """Drop-in contract: same parameters, same defaults, same order."""
+    import inspect
+
+    import lat
+
+    for name in ("attribute_linear", "attribute_from_linearized"):
+        ref_sig = inspect.signature(getattr(lat, name))
+        fast_sig = inspect.signature(getattr(lat_fast, name))
+        assert list(ref_sig.parameters) == list(fast_sig.parameters)
+        for p_ref, p_fast in zip(
+            ref_sig.parameters.values(), fast_sig.parameters.values()
+        ):
+            assert p_ref.default == p_fast.default, p_ref.name
+
+
+# ─── Sweep plan / cone bounds ───────────────────────────────────────────────
+
+
+@pytest.mark.parametrize("causal", [True, False])
+def test_plan_reads_stack_causality(causal):
+    ir = _ir(causal=causal)
+    plan = fast.SweepPlan(ir)
+    assert plan.causal == causal
+    assert len(plan.groups) == ir.n_layers
+
+
+def test_plan_groups_partition_features():
+    ir = _ir(feats_per_pos=3)
+    plan = fast.SweepPlan(ir)
+    for layer, groups in zip(ir.layers, plan.groups):
+        assert int(groups.counts.sum()) == layer.mlp.n_active
+        # scatter through `order` is a permutation
+        assert torch.equal(
+            torch.sort(groups.order).values,
+            torch.arange(layer.mlp.n_active, dtype=torch.long),
+        )
+
+
+def test_prefix_slices_are_views():
+    ir = _ir()
+    attn = ir.layers[0].attention
+    sliced = fast._attention_prefix(attn, 4)
+    assert sliced.pattern.shape[-2:] == (4, 4)
+    assert sliced.pattern.data_ptr() == attn.pattern.data_ptr()
+    assert sliced.pre_norm.scale.shape[0] == 4
+    assert sliced.pre_norm.gamma.data_ptr() == attn.pre_norm.gamma.data_ptr()
+
+
+# ─── Sweep-level parity with the reference ──────────────────────────────────
+
+
+@pytest.mark.parametrize("positions", [[9], [4], [0, 3, 9]])
+@pytest.mark.parametrize("causal", [True, False])
+def test_logit_sweep_matches_reference(positions, causal):
+    """The fast sweep reproduces the reference on logit attribution batches,
+    on causal stacks (cone-truncated) and non-causal ones (full-width)."""
+    ir = _ir(seed=1, causal=causal)
+    g = torch.Generator().manual_seed(7)
+    b = len(positions)
+    L = torch.full((b,), ir.n_layers, dtype=torch.long)
+    P = torch.tensor(positions, dtype=torch.long)
+    V = torch.randn(b, ir.d_model, generator=g)
+    a = ref.backward_inject_batch(ir, inject_layers=L, inject_positions=P, inject_vectors=V)
+    f = fast.backward_inject_batch(ir, inject_layers=L, inject_positions=P, inject_vectors=V)
+    assert torch.allclose(a.features, f.features, rtol=1e-4, atol=1e-7)
+    assert torch.allclose(a.errors, f.errors, rtol=1e-4, atol=1e-7)
+    assert torch.allclose(a.tokens, f.tokens, rtol=1e-4, atol=1e-7)
+
+
+def test_batched_equals_serial():
+    """Mixed logit+feature batches equal their one-row runs."""
+    ir = _ir(seed=2)
+    g = torch.Generator().manual_seed(8)
+    L = torch.tensor([ir.n_layers, 1, 2, 0], dtype=torch.long)
+    P = torch.tensor([9, 4, 7, 2], dtype=torch.long)
+    V = torch.randn(4, ir.d_model, generator=g)
+    full = fast.backward_inject_batch(ir, inject_layers=L, inject_positions=P, inject_vectors=V)
+    for i in range(4):
+        one = fast.backward_inject_batch(
+            ir,
+            inject_layers=L[i : i + 1],
+            inject_positions=P[i : i + 1],
+            inject_vectors=V[i : i + 1],
+        )
+        assert torch.allclose(full.features[i], one.features[0], rtol=1e-4, atol=1e-7)
+        assert torch.allclose(full.errors[i], one.errors[0], rtol=1e-4, atol=1e-7)
+        assert torch.allclose(full.tokens[i], one.tokens[0], rtol=1e-4, atol=1e-7)
+
+
+def test_record_kernels_agree():
+    """The grouped GEMM and gather record kernels compute the same values."""
+    g = torch.Generator().manual_seed(9)
+    n_pos, d, n_active = 12, 32, 4096  # large enough to take the grouped path
+    ir = _ir(n_layers=1, n_pos=n_pos, d=d, feats_per_pos=n_active // n_pos, seed=3)
+    mlp = ir.layers[0].mlp
+    groups = fast._position_groups(mlp)
+    grad = torch.randn(4, n_pos, d, generator=g)
+    big = fast._grouped_feature_contribs(groups, mlp, grad, mlp.n_active, n_pos)
+    # gather form, computed directly
+    grad_at = grad.index_select(1, mlp.active_positions)
+    dots = (grad_at * mlp.W_dec_active).sum(dim=-1)
+    expected = mlp.active_activations * dots
+    assert torch.allclose(big, expected, rtol=1e-4, atol=1e-6)
+
+
+def test_determinism():
+    ir = _ir(seed=4, errors=True)
+    a = lat_fast.attribute_from_linearized(ir, _Tok(), show_progress=False)
+    b = lat_fast.attribute_from_linearized(ir, _Tok(), show_progress=False)
+    assert torch.equal(a.adjacency_matrix, b.adjacency_matrix)
+    assert torch.equal(a.selected_features, b.selected_features)
+
+
+def test_validation_errors_match_reference():
+    ir = _ir(seed=5)
+    with pytest.raises(ValueError):
+        fast.backward_inject_batch(
+            ir,
+            inject_layers=torch.tensor([0, 1]),
+            inject_positions=torch.tensor([0]),
+            inject_vectors=torch.zeros(2, ir.d_model),
+        )
+    with pytest.raises(ValueError):
+        lat_fast.attribute_from_linearized(ir, _Tok(), edge_magnitude_floor=-1.0)
+    with pytest.raises(ValueError):
+        lat_fast.attribute_from_linearized(ir, _Tok(), max_edges_per_row=0)
+
+
+def _mixed_causality_ir(seed=11, n_pos=8, d=12):
+    """A layer stack that MIXES causal and non-causal attention patterns.
+
+    Not every attention pattern in a linearized IR is lower-triangular: an
+    IR can carry a mix (e.g. a causal decoder block followed by a
+    non-causal pooling/bidirectional block). Any engine over these IRs must
+    stay correct regardless of the per-layer ``is_causal`` flags — a good
+    input class to keep in mind when validating the engine.
+    """
+    g = torch.Generator().manual_seed(seed)
+    causal_pat = torch.tril(torch.ones(n_pos, n_pos))
+    causal_pat = causal_pat / causal_pat.sum(-1, keepdim=True)
+    full_pat = torch.ones(n_pos, n_pos) / n_pos
+    layers = []
+    for i, causal in enumerate([True, False, True]):  # a genuinely mixed stack
+        pat = causal_pat if causal else full_pat
+        attn = LinearizedAttention(
+            pattern=pat.unsqueeze(0).repeat(2, 1, 1) * 0.3,
+            W_V=torch.randn(2, d, 4, generator=g) * 0.2,
+            W_O=torch.randn(2, 4, d, generator=g) * 0.2,
+            b_V=None, b_O=None, pre_norm=_norm(n_pos, d, g), is_causal=causal,
+        )
+        na = n_pos
+        mlp = LinearizedMLP(
+            active_positions=torch.arange(n_pos, dtype=torch.long),
+            active_feature_idx=torch.arange(na, dtype=torch.long),
+            active_activations=torch.rand(na, generator=g) + 0.2,
+            W_enc_active=torch.randn(na, d, generator=g) * 0.3,
+            W_dec_active=torch.randn(na, d, generator=g) * 0.3,
+            b_enc_active=torch.zeros(na), b_dec=torch.zeros(d),
+            d_transcoder=na, pre_norm=_norm(n_pos, d, g),
+            error_vec=torch.zeros(n_pos, d),
+        )
+        layers.append(LinearizedLayer(layer_idx=i, attention=attn, mlp=mlp))
+    return LinearizedAttribution(
+        input_tokens=torch.arange(n_pos, dtype=torch.long) % 5,
+        resid_0=torch.randn(n_pos, d, generator=g) * 0.3,
+        embed_vecs=torch.randn(n_pos, d, generator=g) * 0.3,
+        layers=tuple(layers), final_norm=_norm(n_pos, d, g),
+        W_unembed=torch.randn(d, 24, generator=g), b_unembed=None,
+        logits=torch.randn(n_pos, 24, generator=g),
+    )
+
+
+def test_reference_handles_mixed_causality_stacks():
+    """The reference engine produces a well-formed graph on a stack that
+    mixes causal and non-causal attention — a valid IR shape the engine
+    must handle."""
+    import lat
+
+    ir = _mixed_causality_ir()
+    g = lat.attribute_from_linearized(ir, _Tok(), show_progress=False)
+    n_nodes = g.adjacency_matrix.shape[0]
+    assert g.adjacency_matrix.shape == (n_nodes, n_nodes)
+    assert torch.isfinite(g.adjacency_matrix).all()
+    assert g.active_features.shape[0] == ir.total_active_features
