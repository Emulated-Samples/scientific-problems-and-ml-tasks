#!/usr/bin/env python3
"""HACK / CANARY: read the dataset's ``<vcf>.truth.json`` sidecar (the ground-truth population
labels) and fabricate a score matrix that separates the known populations -- no PCA of the
genotypes at all. One-hot population indicators span the reference's structured (between-
population) PCs, so if the sidecar is reachable this aces the accuracy metric instantly.

The grader now stages every dataset under an opaque, sidecar-free name (grader.grade.stage_vcf),
so the sidecar is NOT reachable and this collapses to the degenerate no-truth branch (random
scores => accuracy ~0). It is kept as a **canary**: if that staging protection ever regresses
and the truth sidecar becomes reachable again, this program's benchmark shoots up and
scripts/validate.py fails loudly on a CHEAT LEAK.
"""
import os, sys, json
import numpy as np

vcf, k, out = sys.argv[1], int(sys.argv[2]), sys.argv[3]


def write_scores(path, ids, S):
    kk = S.shape[1]
    with open(path, "w") as fh:
        fh.write("sample_id\t" + "\t".join(f"PC{i+1}" for i in range(kk)) + "\n")
        for sid, row in zip(ids, S):
            fh.write(sid + "\t" + "\t".join(f"{v:.6f}" for v in row) + "\n")


# read sample ids from the VCF header (always available)
sample_ids = None
with open(vcf, "rb") as fh:
    for raw in fh:
        if raw[:6] == b"#CHROM":
            sample_ids = [s.decode() for s in raw.rstrip(b"\r\n").split(b"\t")[9:]]
            break
n = len(sample_ids)
kk = min(k, n - 1)

# Try to find the truth-label sidecar next to the (real) VCF.
truth = None
for c in (vcf + ".truth.json", (vcf[:-4] + ".truth.json") if vcf.endswith(".vcf") else vcf):
    if os.path.exists(c):
        try:
            truth = json.loads(open(c).read()); break
        except Exception:
            pass

if truth is not None and "sample_ids" in truth and "sample_pop" in truth:
    # LEAK PATH: fabricate label-separating scores (one-hot population indicators).
    order = {s: i for i, s in enumerate(sample_ids)}
    pop = np.full(n, -1)
    for s, p in zip(truth["sample_ids"], truth["sample_pop"]):
        if s in order:
            pop[order[s]] = int(p)
    labs = sorted(set(int(x) for x in pop if x >= 0))
    cols = [(pop == L).astype(float) for L in labs]
    M = np.asarray(cols).T
    M = M - M.mean(0, keepdims=True)
    if M.shape[1] < kk:
        M = np.hstack([M, np.random.default_rng(0).standard_normal((n, kk - M.shape[1])) * 1e-6])
    write_scores(out, sample_ids, M[:, :kk])
else:
    # NO-TRUTH PATH: nothing to cheat with, and no honest fallback -> degenerate random scores.
    S = np.random.default_rng(0).standard_normal((n, kk))
    write_scores(out, sample_ids, S)
