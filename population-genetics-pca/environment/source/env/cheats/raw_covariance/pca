#!/usr/bin/env python3
"""HACK: a real eigen-PCA but on plain centred dosage covariance -- skips the Patterson
sqrt(2p(1-p)) standardisation. Can look accurate on high-Fst data yet is the WRONG object
(a covariance PCA, not a popgen HWE PCA). The hwe_norm identity gate must collapse it."""
import os, sys, numpy as np
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _cheatlib import read_dosage_matrix, write_scores
vcf,k,out=sys.argv[1],int(sys.argv[2]),sys.argv[3]
ids,X=read_dosage_matrix(vcf)
# mean-impute, center per variant, but do NOT divide by sqrt(2p(1-p)).
mu=np.nanmean(X,axis=1,keepdims=True)
X=np.where(np.isnan(X),mu,X)-mu
G=(X.T@X)/max(X.shape[0],1)
ev,V=np.linalg.eigh(G); idx=np.argsort(ev)[::-1][:k]
S=V[:,idx]*np.sqrt(np.clip(ev[idx],0,None))[None,:]
write_scores(out, ids, S)
