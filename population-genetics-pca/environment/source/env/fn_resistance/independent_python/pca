#!/usr/bin/env python3
"""Independent, genuinely-correct Patterson PCA -- the standing false-positive guard.

Written independently of reference/ (its own VCF parser, its own standardisation, and its own
linear-algebra implementation) so that "a genuine PCA is never rejected"-style breakage shows
up loudly: this program must retain near-unit scientific accuracy and method factors across every
category. It reads the whole file (no subsampling), so its bounded systems score is intentionally
partial while the scientific gates must never punish it.

Contract:  pca <vcf> <k> <out.tsv>
"""
import sys
import gzip
import numpy as np


def openf(p):
    return gzip.open(p, "rt") if p.endswith((".gz", ".bgz")) else open(p, "rt")


def decode_line(sample_block: str, n: int):
    """Independent FORMAT-aware GT decode; malformed individual calls become missing."""
    fields = sample_block.split("\t")
    if len(fields) != n:
        return None
    dose = np.empty(n, dtype=np.float64)
    for i, fld in enumerate(fields):
        gt = fld.split(":", 1)[0]
        if gt == "0":
            dose[i] = 0.0
        elif gt == "1":
            dose[i] = 2.0
        elif (len(gt) == 3 and gt[1] in "/|"
              and gt[0] in "01" and gt[2] in "01"):
            dose[i] = (gt[0] == "1") + (gt[2] == "1")
        else:
            dose[i] = np.nan
    return dose


def main():
    vcf, k, out = sys.argv[1], int(sys.argv[2]), sys.argv[3]
    samples = None
    cols = []          # list of standardized per-variant sample vectors
    n = None
    with openf(vcf) as fh:
        for line in fh:
            if line.startswith("##"):
                continue
            if line.startswith("#CHROM"):
                samples = line.rstrip("\r\n").split("\t")[9:]
                n = len(samples)
                continue
            # Split off only the fixed fields; keep the sample block as raw bytes.
            f = line.rstrip("\r\n").split("\t", 9)
            if len(f) < 10:
                continue
            ref, alt = f[3], f[4]
            if (len(ref) != 1 or len(alt) != 1
                    or ref.upper() not in "ACGT" or alt.upper() not in "ACGT"):
                continue
            if f[8] != "GT" and not f[8].startswith("GT:"):
                continue
            dose = decode_line(f[9], n)
            if dose is None:
                continue
            obs = ~np.isnan(dose)
            if obs.sum() < 2 or np.var(dose[obs]) <= 0.0:
                continue
            p = dose[obs].sum() / (2.0 * obs.sum())
            if not (1e-6 < p < 1 - 1e-6):
                continue
            s = np.sqrt(2 * p * (1 - p))
            dose = np.where(np.isnan(dose), 2 * p, dose)
            cols.append((dose - 2 * p) / s)

    Z = np.asarray(cols).T                 # (n_samples, n_variants)
    n = Z.shape[0]
    m = max(Z.shape[1], 1)
    kk = min(k, n - 1)
    if n <= m:
        # Dense sample-by-sample Gram (n<=m), eigendecomposed: exact and far cheaper than a full
        # SVD of Z. eigenvectors scaled by sqrt(eigenvalue) are the PC scores.
        G = (Z @ Z.T) / m
        evals, evecs = np.linalg.eigh(G)
        idx = np.argsort(evals)[::-1][:kk]
        scores = evecs[:, idx] * np.sqrt(np.clip(evals[idx], 0, None))[None, :]
    else:
        # More samples than markers. Here the n x n sample Gram is simply the wrong object to
        # build: at biobank scale it does not fit in memory at all. Z Z^T and Z^T Z share their
        # nonzero spectrum, so decompose the small m x m marker Gram instead and map back. If
        # H u = mu * u then Z u is a sample-space eigenvector with the same eigenvalue mu, with
        # norm sqrt(m * mu); scaling the unit eigenvector by sqrt(mu) therefore makes the PC score
        # exactly Z u / sqrt(m) -- mu cancels. Same Patterson object, same answer, O(m^2) memory.
        H = (Z.T @ Z) / m
        evals, evecs = np.linalg.eigh(H)
        idx = np.argsort(evals)[::-1][:kk]
        scores = (Z @ evecs[:, idx]) / np.sqrt(m)
    for c in range(kk):
        col = scores[:, c]
        if col[np.argmax(np.abs(col))] < 0:
            scores[:, c] = -col

    with open(out, "w") as fh:
        fh.write("sample_id\t" + "\t".join(f"PC{i+1}" for i in range(kk)) + "\n")
        for sid, row in zip(samples, scores):
            fh.write(sid + "\t" + "\t".join(f"{v:.6f}" for v in row) + "\n")


if __name__ == "__main__":
    main()
